# Copy to .env and adjust.  Read by scripts/*.sh and by train_aero.paths.

# PhysicsNeMo checkout that provides the unified external-aero recipe (tested at fb5b9a2)
PHYSICSNEMO_ROOT=/path/to/physicsnemo
# PhysicsNeMo-CFD checkout that provides workflows/benchmarking (tested at 43e531a)
PHYSICSNEMO_CFD_ROOT=/path/to/physicsnemo-cfd
# Work directory: data copies, runs, checkpoints, benchmark outputs (default: ./workdir)
TRAIN_AERO_WORKDIR=/path/to/workdir
# Curated .pdmsh datasets (train_noses, train_lengths and their *_shuffled copies)
TRAIN_AERO_SOURCE_DATA=/path/to/datasets
# Python interpreter of the environment with physicsnemo + physicsnemo-cfd installed
PYTHON=python

# WSL2 only: Warp does not see the GPU without the WSL driver libraries
# LD_LIBRARY_PATH=/usr/lib/wsl/lib
